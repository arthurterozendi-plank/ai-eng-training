# Copy to .env.local at the repository root and fill in. One file serves every workspace: the
# app and the database scripts are both launched through `dotenv -e ../../.env.local`, because
# Next.js only reads .env files from its own project directory and never from a parent.
#
# /pre-deploy fails on any key here that has no value — except keys below a line reading exactly
# `# @local-only`. That section is for keys only a local developer tool reads, such as an MCP
# server's credentials: they are still declared here, so the drift check knows they exist, but a
# deploy never requires them. The section runs to the end of the file, so keep it last and add
# deploy keys above it.

# Validated by apps/web/src/env.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Postgres, pooled connection (Supavisor, transaction mode, port 6543 on hosted).
# Validated by packages/db/src/env.ts. Read by packages/db/src/client.ts, the request-path
# ORM client every app query goes through.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Direct connection (port 5432). Migrations and the seed script use this one: DDL and the
# advisory locks the migrator takes do not survive the transaction pooler. The talentscout-db
# MCP server (apps/mcp-db) reads through it too, for the same reason: its read-only guarantees
# are session-scoped and a pooler may silently drop them.
# Validated by packages/db/src/env.ts.
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# PostHog's private API, read only by the talentscout-posthog MCP server (apps/mcp-posthog).
# Validated by apps/mcp-posthog/src/env.ts. No defaults: the region and the project are not
# known until a PostHog project exists, and the server runs without them — every tool then
# names the missing keys.
# The app host for your region: https://us.posthog.com or https://eu.posthog.com. Not the
# ingestion host (us.i.posthog.com) the browser SDK sends events to.
POSTHOG_API_HOST=
# Numeric, from PostHog's project settings.
POSTHOG_PROJECT_ID=
# A personal API key (phx_…) with the query:read, event_definition:read and
# property_definition:read scopes — never the project token (phc_…).
POSTHOG_PERSONAL_API_KEY=
