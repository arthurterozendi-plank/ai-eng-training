  "devDependencies": {
    "@talentscout/eslint-config": "workspace:*",
    "@talentscout/typescript-config": "workspace:*",
    "@types/node": "^20",
    "@vitest/coverage-v8": "^4.1.10",
    "dotenv-cli": "^10.0.0",
    "eslint": "^9",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
